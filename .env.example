# COPY TO .env; supply your own secret. Never put this in browser-side code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# For commercial production campaigns, use licensed Open-Meteo customer credentials:
WEATHER_API_KEY=
# Recommended persistent keys in production (random values at least 32 bytes):
SIGNING_SECRET=
ADMIN_TOKEN=
# Persistent event storage, e.g. a Render disk mount (/var/data):
EVENTS_DIR=
PORT=3000
